-- Features.
local function setEsp(state)
	flags.esp = state
	if state then
		task.spawn(function()
			while flags.esp do
				for _, player in ipairs(playersService:GetPlayers()) do
					if player ~= localPlayer and player.Character and not highlights[player] then
						local highlight = Instance.new("Highlight")
						highlight.FillColor = COLOR_ACCENT
						highlight.Parent = player.Character
						highlights[player] = highlight
					end
					if highlights[player] and not highlights[player].Parent then
						highlights[player] = nil
					end
				end
				task.wait(1)
			end
		end)
		return
	end
	for player, highlight in pairs(highlights) do
		highlight:Destroy()
		highlights[player] = nil
	end
end

local function setFullbright(state)
	flags.fullbright = state
	lightingService.Brightness = state and 3 or 1
	lightingService.GlobalShadows = not state
	lightingService.FogEnd = state and 1e6 or 1000
end

