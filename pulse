-- Highlight the selected row and keep it visible in the scroll frame.
local function selectRow(index)
	if #rows == 0 then
		return
	end
	selectedIndex = math.clamp(index, 1, #rows)
	for i, entry in ipairs(rows) do
		entry.row.BackgroundColor3 = i == selectedIndex and COLOR_ACCENT or COLOR_ROW
	end
	local top = (selectedIndex - 1) * (ROW_HEIGHT + ROW_PADDING)
	local bottom = top + ROW_HEIGHT
	local viewHeight = content.AbsoluteWindowSize.Y
	if top < content.CanvasPosition.Y then
		content.CanvasPosition = Vector2.new(0, top)
	elseif bottom > content.CanvasPosition.Y + viewHeight then
		content.CanvasPosition = Vector2.new(0, bottom - viewHeight)
	end
end

local function clearContent()
	for _, child in ipairs(content:GetChildren()) do
		if child:IsA("GuiButton") then
			child:Destroy()
		end
	end
	table.clear(rows)
	content.CanvasPosition = Vector2.zero
end

local function addRow(text, suffix, callback)
	local row = create("TextButton", {
		Size = UDim2.new(1, 0, 0, ROW_HEIGHT),
		BackgroundColor3 = COLOR_ROW,
		BorderSizePixel = 0,
		Text = "   " .. text,
		Font = Enum.Font.GothamBold,
		TextSize = 13,
		TextColor3 = COLOR_TEXT,
		TextXAlignment = Enum.TextXAlignment.Left,
		AutoButtonColor = false,
	}, content)
	local tag = create("TextLabel", {
		Size = UDim2.new(0, 50, 1, 0),
		Position = UDim2.new(1, -56, 0, 0),
		BackgroundTransparency = 1,
		Text = suffix,
		Font = Enum.Font.GothamBold,
		TextSize = 12,
		TextColor3 = COLOR_TEXT,
	}, row)
	local entry = { row = row, tag = tag, callback = callback }
	table.insert(rows, entry)
	row.MouseButton1Click:Connect(function()
		selectRow(table.find(rows, entry) or 1)
		callback(row, tag)
	end)
	return row, tag
end

local showMain, showCategory

showCategory = function(category, index)
	clearContent()
	goBack = showMain
	footer.Text = category.name .. "   " .. index .. "/" .. #categories
	addRow("< Retour", "", function() showMain() end)
	if #category.entries == 0 then
		addRow("Aucune option", "", function() end)
	end
	for _, entry in ipairs(category.entries) do
		if entry.toggle then
			local state = false
			addRow(entry.text, "OFF", function(row, tag)
				state = not state
				tag.Text = state and "ON" or "OFF"
				tag.TextColor3 = state and Color3.fromRGB(60, 220, 120) or COLOR_TEXT
				entry.toggle(state)
			end)
		else
			addRow(entry.text, "RUN", function() entry.action() end)
		end
	end
	selectRow(1)
end

showMain = function()
	clearContent()
	goBack = nil
	footer.Text = "Ødcleak   1/" .. #categories
	for index, category in ipairs(categories) do
		addRow(category.name, "[>]", function() showCategory(category, index) end)
	end
	selectRow(1)
end

